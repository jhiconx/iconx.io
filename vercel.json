{
  "functions": {
    "api/contact.js": {
      "maxDuration": 10
    },
    "api/admin-leads.js": {
      "maxDuration": 10
    }
  },
  "redirects": [
    {
      "source": "/xmas/",
      "destination": "/xmas",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/xmas",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        }
      ]
    }
  ]
}
